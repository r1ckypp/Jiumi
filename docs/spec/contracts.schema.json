{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/pet"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/rule"
    },
    {
      "$ref": "#/$defs/module"
    }
  ],
  "$defs": {
    "appearance": {
      "type": "object",
      "required": [],
      "properties": {
        "scale": {
          "type": "integer",
          "minimum": 60,
          "maximum": 110
        },
        "ears": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "hue": {
          "type": "integer",
          "minimum": -180,
          "maximum": 180
        },
        "eyes": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "nose": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "inner": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "motions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "pet": {
      "type": "object",
      "required": [
        "id",
        "name",
        "color",
        "plugins",
        "revision"
      ],
      "properties": {
        "defaultLanguage": {"enum": ["en", "zh-CN"]},
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "image": {
          "type": "string"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "clips": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "not": {
              "const": "constructor"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/clip"
          },
          "maxProperties": 256
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          },
          "maxItems": 8
        },
        "moduleState": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "motionPools": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "not": {
              "const": "constructor"
            }
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$",
              "not": {
                "const": "constructor"
              }
            }
          }
        },
        "rig": {
          "$ref": "#/$defs/rig"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "v",
        "type",
        "source",
        "at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "v": {
          "const": 1
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "at": {
          "type": "integer"
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "maxLength": 160
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "agent.started",
                  "agent.resumed",
                  "agent.input_requested",
                  "agent.completed",
                  "agent.closed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "session"
            ]
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "version",
        "name",
        "on"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "on": {
          "type": "string"
        },
        "intent": {
          "enum": [
            "affection",
            "attention",
            "celebrate"
          ]
        },
        "effect": {
          "const": "particles"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "clip": {
      "type": "object",
      "required": [
        "frameMs",
        "frames",
        "loop"
      ],
      "properties": {
        "frameMs": {
          "type": "integer",
          "minimum": 40,
          "maximum": 1000
        },
        "loop": {
          "type": "boolean"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^data:image/png;base64,"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "wasmModule": {
      "type": "object",
      "required": [
        "id",
        "api",
        "version",
        "name",
        "events",
        "capabilities",
        "wasm",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "not": {
            "const": "constructor"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "api": {
          "const": 1
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 24
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "motion",
              "state"
            ]
          },
          "maxItems": 2
        },
        "wasm": {
          "type": "string",
          "maxLength": 90000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "not": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "state-machine",
              "session-notice",
              "speech"
            ]
          }
        }
      }
    },
    "machineModule": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "name",
        "api",
        "version",
        "priority",
        "enter",
        "states"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "not": {
            "const": "constructor"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "api": {
          "const": 1
        },
        "kind": {
          "const": "state-machine"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "enter": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "allOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "not": {
                  "const": "constructor"
                }
              },
              {
                "not": {
                  "const": "free"
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "motion"
            ],
            "properties": {
              "motion": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "not": {
                  "const": "constructor"
                }
              },
              "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 2147483647},
              "resumeAt": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "on": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "menu": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "not": {
              "const": "constructor"
            }
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 80,
            "pattern": "\\S"
          }
        }
      }
    },
    "module": {
      "oneOf": [
        {
          "$ref": "#/$defs/wasmModule"
        },
        {
          "$ref": "#/$defs/machineModule"
        },
        {
          "$ref": "#/$defs/speechModule"
        },
        {
          "$ref": "#/$defs/noticeModule"
        }
      ]
    },
    "speechModule": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "api",
        "kind",
        "lines",
        "minSeconds",
        "maxSeconds",
        "durationSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "not": {
            "const": "constructor"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "api": {
          "const": 1
        },
        "kind": {
          "const": "speech"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 48,
            "pattern": "\\S"
          }
        },
        "minSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "noticeModule": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "api",
        "kind",
        "show",
        "clear",
        "title",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "not": {
            "const": "constructor"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "api": {
          "const": 1
        },
        "kind": {
          "const": "session-notice"
        },
        "show": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "clear": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "action": {
          "const": "session.open"
        }
      }
    },
    "rig": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sugar",
            "humanoid"
          ]
        },
        "species": {
          "enum": [
            "chick",
            "pig",
            "bunny",
            "cat",
            "cow",
            "elephant"
          ]
        },
        "layers": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "pattern": "^data:image/png;base64,"
          }
        },
        "poses": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "object",
            "required": [
              "duration",
              "joints"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 64
              },
              "duration": {
                "type": "integer",
                "minimum": 40,
                "maximum": 30000
              },
              "joints": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 32,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 64,
                  "items": {
                    "type": "number",
                    "minimum": -720,
                    "maximum": 720
                  }
                }
              }
            }
          }
        },
        "style": {
          "enum": [
            "humanoid",
            "knight"
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "sugar"
          }
        }
      },
      "then": {
        "required": [
          "species"
        ]
      }
    }
  }
}
